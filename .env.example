# Copy this file to .env before production use and replace every password.
# Use URL-safe characters for MongoDB and RabbitMQ passwords.
ARL_PORT=5003

MONGO_USERNAME=arl
MONGO_PASSWORD=arl-mongo-change-me
MONGO_DATABASE=arl

RABBITMQ_USERNAME=arl
RABBITMQ_PASSWORD=arl-rabbit-change-me
RABBITMQ_VHOST=arlv2host

ARL_ADMIN_USERNAME=admin
ARL_ADMIN_PASSWORD=arlpass
ARL_API_WORKERS=4
ARL_WORKER_CONCURRENCY=5
ARL_GITHUB_WORKER_CONCURRENCY=3

# Optional AI service. The service stays healthy when disabled.
ARL_AI_ENABLED=false
ARL_AI_BASE_URL=https://api.openai.com/v1
ARL_AI_MODEL=
ARL_AI_API_KEY=
ARL_AI_TIMEOUT=120
ARL_AI_MAX_CONTEXT_BYTES=102400

# Container log rotation and resource ceilings (Compose units are accepted).
ARL_LOG_MAX_SIZE=10m
ARL_LOG_MAX_FILES=3
ARL_MONGO_CPUS=1.5
ARL_MONGO_MEMORY=2g
ARL_RABBITMQ_CPUS=1.0
ARL_RABBITMQ_MEMORY=1g
ARL_API_CPUS=2.0
ARL_API_MEMORY=2g
ARL_AI_CPUS=2.0
ARL_AI_MEMORY=2g
ARL_WORKER_CPUS=4.0
ARL_WORKER_MEMORY=6g
ARL_GITHUB_WORKER_CPUS=1.5
ARL_GITHUB_WORKER_MEMORY=1g
ARL_SCHEDULER_CPUS=0.5
ARL_SCHEDULER_MEMORY=512m
ARL_GATEWAY_CPUS=0.5
ARL_GATEWAY_MEMORY=256m

# Optional backup service: docker compose --profile backup up -d mongo-backup
MONGO_BACKUP_INTERVAL_SECONDS=86400
MONGO_BACKUP_RETENTION_DAYS=14
ARL_BACKUP_CPUS=1.0
ARL_BACKUP_MEMORY=1g
