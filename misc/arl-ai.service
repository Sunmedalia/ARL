[Unit]
Description=ARL AI Streaming Service
After=network.target mongod.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/ARL
EnvironmentFile=-/etc/arl/ai.env
ExecStart=/usr/local/bin/gunicorn -b 127.0.0.1:5014 app.ai_main:ai_app -w 2 --threads 4 --worker-class gthread --timeout 130 --access-logfile arl_ai.log
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure

[Install]
WantedBy=multi-user.target
